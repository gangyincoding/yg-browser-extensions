{
  "manifest_version": 3,
  "name": "多多商品素材下载器",
  "version": "1.2.1",
  "description": "打开拼多多商品页后，分类下载主图、SKU 图、详情图/视频和卖家秀视频。优先使用原图原视频地址，去除缩放与水印参数，不做二次压缩。",
  "action": {
    "default_title": "多多商品素材下载器",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["downloads", "storage"],
  "host_permissions": [
    "*://*.yangkeduo.com/*",
    "*://*.pinduoduo.com/*",
    "*://*.pddpic.com/*",
    "*://*.yangkeduo.net/*",
    "*://*.pddugc.com/*",
    "*://*.byteimg.com/*",
    "*://*.bytecdn.cn/*",
    "*://*.alicdn.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.yangkeduo.com/*",
        "*://*.pinduoduo.com/*"
      ],
      "js": ["injected.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.yangkeduo.com/*",
        "*://*.pinduoduo.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["panel.css"],
      "matches": ["*://*.yangkeduo.com/*", "*://*.pinduoduo.com/*"]
    }
  ]
}
